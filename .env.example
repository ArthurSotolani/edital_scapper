# Configuração do Sistema de Filtro de Editais SIGProj com IA

# Escolha o provedor de IA: "gemini", "openai", "groq", "ollama", ou "heuristic" (sem chave)
AI_PROVIDER=gemini

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo do Gemini (ex: gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Caso prefira usar OpenAI ou Provedor compatível (Groq, Together, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Para Groq: https://api.groq.com/openai/v1
# Para Ollama local: http://localhost:11434/v1
OPENAI_BASE_URL=

# Pontuação mínima de relevância (0 a 100) para considerar o edital relevante
MIN_RELEVANCE_SCORE=60

# URL base do SIGProj
SIGPROJ_BASE_URL=https://sigproj.ufms.br
